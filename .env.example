# Environment Mode: TESTNET or REAL or PAPER
TAMA_ENV=TESTNET

# Execution: LIVE_ORDERS or PAPER_ORDERS
TAMA_EXECUTION=LIVE_ORDERS

# Capital Mode: EXCHANGE_DYNAMIC (full account sync) or ALLOCATED_SANDBOX (fixed virtual margin)
TAMA_CAPITAL_MODE=EXCHANGE_DYNAMIC
TAMA_ALLOCATED_BUDGET=50.00

# Binance USDT-M Futures API Credentials
BINANCE_TESTNET_KEY=your_testnet_api_key_here
BINANCE_TESTNET_SECRET=your_testnet_api_secret_here

BINANCE_API_KEY=your_real_api_key_here
BINANCE_API_SECRET=your_real_api_secret_here
